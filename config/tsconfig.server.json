{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../build",
    "rootDir": "..",
    "noEmit": false,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "noImplicitAny": false,
    "declaration": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "../server/**/*.ts",
    "../shared/**/*.ts"
  ],
  "exclude": [
    "src",
    "node_modules",
    "../server/**/*.test.ts",
    "../server/lib/test-setup.ts"
  ]
}