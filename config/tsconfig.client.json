{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "paths": {
      "*": [
        "../src/*"
      ],
      "shared/*": [
        "../shared/*"
      ]
    },
    "moduleResolution": "Bundler",
    "module": "esnext",
    "jsx": "react"
  },
  "include": [
    "../src/**/*",
    "../shared/**/*",
    "./declarations.d.ts"
  ]
}