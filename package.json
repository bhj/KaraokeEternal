{
  "name": "karaoke-eternal",
  "version": "0.0.0-dev.0",
  "description": "Open karaoke party system",
  "keywords": [
    "karaoke",
    "party",
    "player",
    "lyrics",
    "cdgraphics",
    "cdg",
    "mp3+g",
    "mp4",
    "webgl"
  ],
  "homepage": "https://www.karaoke-eternal.com",
  "type": "module",
  "main": "./build/server/main.js",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "docs:serve": "hugo serve --source docs -b http://localhost:1313 --bind 0.0.0.0",
    "dev": "NODE_ENV=development tsx watch server/main.ts -p 3000",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run --config config/vitest.config.ts",
    "typecheck": "tsc -b --noEmit",
    "build": "npm run build:server ; npm run build:client",
    "build:client": "webpack --config config/webpack.config.js",
    "build:server": "rm -rf build/server ; tsc -p config/tsconfig.server.json --noEmitOnError false ; mkdir -p build/server/lib ; cp -R server/lib/schemas build/server/lib/",
    "serve": "node build/server/main.js",
    "server": "npm run serve"
  },
  "files": [
    "assets/**",
    "build/client/**",
    "build/server/**",
    "build/shared/**"
  ],
  "bin": {
    "karaoke-eternal-server": "build/server/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhj/KaraokeEternal.git"
  },
  "productName": "Karaoke Eternal Server",
  "author": "RadRoot LLC",
  "license": "ISC",
